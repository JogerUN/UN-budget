---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import MessageCard from "../components/MessageCard.astro";
---

<BaseLayout title="Gestor de Finanzas | Walking Skeleton">
	 <MessageCard />
</BaseLayout>

<script>
  import { testEndToEndFlow } from '../scripts/api-client.js';

  const overallBadge = document.getElementById('overall-badge');
  const stepNginx = document.getElementById('step-nginx');
  const stepBackend = document.getElementById('step-backend');
  const stepDb = document.getElementById('step-db');

  const loadingEl = document.getElementById('state-loading');
  const successEl = document.getElementById('state-success');
  const errorEl = document.getElementById('state-error');
  const messageTextEl = document.getElementById('db-message-text');
  const responseMetaEl = document.getElementById('response-meta');
  const errorDetailEl = document.getElementById('error-detail-text');
  const lastCheckedEl = document.getElementById('last-checked');
  const retryBtn = document.getElementById('btn-retry');

  function setBadge(el, text, variant) {
    if (!el) return;
    el.textContent = text;
    el.className = `badge bg-${variant}`;
  }

  function showPanel(panel) {
    loadingEl?.classList.toggle('d-none', panel !== 'loading');
    successEl?.classList.toggle('d-none', panel !== 'success');
    errorEl?.classList.toggle('d-none', panel !== 'error');
  }

  async function runDiagnostics() {
    showPanel('loading');
    setBadge(overallBadge, 'Probando...', 'secondary');
    setBadge(stepNginx, 'En curso', 'warning text-dark');
    setBadge(stepBackend, 'Esperando', 'secondary');
    setBadge(stepDb, 'Esperando', 'secondary');

    try {
      const { message, status, latencyMs } = await testEndToEndFlow();

      // Si hay respuesta 200 OK con dato válido, las 4 capas completaron el recorrido
      setBadge(stepNginx, 'OK (Proxy)', 'success');
      setBadge(stepBackend, `OK (${status})`, 'success');
      setBadge(stepDb, 'Conectada', 'success');
      setBadge(overallBadge, 'Cadena Completa', 'success');

      if (messageTextEl) messageTextEl.textContent = message;
      if (responseMetaEl) responseMetaEl.textContent = `Tiempo de respuesta end-to-end: ${latencyMs} ms`;
      showPanel('success');
    } catch (err) {
      const status = err?.status;

      if (status === 502 || status === 504) {
        // Nginx respondió, pero el contenedor backend:8000 no está disponible
        setBadge(stepNginx, 'OK (Proxy)', 'success');
        setBadge(stepBackend, `Fallo (${status})`, 'danger');
        setBadge(stepDb, 'Sin alcanzar', 'secondary');
      } else if (status === 500 || status === 503) {
        // FastAPI respondió con error interno (ej. fallo de conexión a PostgreSQL)
        setBadge(stepNginx, 'OK (Proxy)', 'success');
        setBadge(stepBackend, 'Activo', 'warning text-dark');
        setBadge(stepDb, `Error (${status})`, 'danger');
      } else {
        // Error en desarrollo local (404 de Astro) o caída total de red
        setBadge(stepNginx, `Error (${status || 'Red'})`, 'danger');
        setBadge(stepBackend, 'Sin alcanzar', 'secondary');
        setBadge(stepDb, 'Sin alcanzar', 'secondary');
      }

      setBadge(overallBadge, 'Flujo Interrumpido', 'danger');
      if (errorDetailEl) {
        errorDetailEl.textContent = err instanceof Error ? err.message : 'Error desconocido en la red.';
      }
      showPanel('error');
    } finally {
      if (lastCheckedEl) {
        lastCheckedEl.textContent = `Última prueba: ${new Date().toLocaleTimeString()}`;
      }
    }
  }

  retryBtn?.addEventListener('click', runDiagnostics);
  runDiagnostics();
</script>



<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
</html>
